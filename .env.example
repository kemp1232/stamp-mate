# Copy this file to .env and fill in real values. Never commit .env.
# See README.md "Environment variables" for where to get these.

# Pooled Postgres connection string, used by the app at runtime.
# Supabase: Project Settings -> Database -> Connection string (use the "Transaction" pooler, port 6543).
DATABASE_URL="postgresql://postgres:password@localhost:6543/postgres?pgbouncer=true"

# Direct (non-pooled) Postgres connection string, used by `prisma migrate`.
# Supabase: Project Settings -> Database -> Connection string (use the direct connection, port 5432).
DIRECT_URL="postgresql://postgres:password@localhost:5432/postgres"

# Random secret used to sign session cookies. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-random-generated-secret"

# The app's own base URL — also used to build QR code links (join/card URLs).
# Use your deployed domain in production (e.g. https://your-app.vercel.app), not localhost.
BETTER_AUTH_URL="http://localhost:3000"
